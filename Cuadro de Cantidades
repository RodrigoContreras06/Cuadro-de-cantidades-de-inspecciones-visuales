<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - Inspecciones Visuales de Integridad | Confipetrol</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- FontAwesome para iconos -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Chart.js para gráficos -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        body {
            background-color: #0d1b2a;
            color: #f8f9fa;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        .header-logo {
            background-color: #ffffff;
            padding: 15px;
            border-radius: 8px;
            text-align: center;
            margin-bottom: 20px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        }
        .card-kpi {
            background: #ffffff;
            color: #212529;
            border-radius: 8px;
            padding: 15px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
            text-align: center;
            margin-bottom: 15px;
            border-top: 4px solid #1b365d;
        }
        .card-kpi.alta { border-top-color: #dc3545; }
        .card-kpi.media { border-top-color: #ffc107; }
        .card-kpi.baja { border-top-color: #198754; }
        
        .kpi-title {
            font-size: 0.85rem;
            font-weight: 700;
            text-transform: uppercase;
            color: #6c757d;
        }
        .kpi-value {
            font-size: 1.8rem;
            font-weight: 700;
            color: #1b365d;
        }
        .chart-container {
            background: #ffffff;
            color: #212529;
            border-radius: 8px;
            padding: 20px;
            margin-bottom: 20px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        }
        .table-section {
            background: #ffffff;
            color: #212529;
            border-radius: 8px;
            padding: 20px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        }
    </style>
</head>
<body class="container-fluid py-4">

    <!-- Encabezado -->
    <div class="row">
        <div class="col-12">
            <div class="header-logo d-flex justify-content-between align-items-center">
                <h3 class="text-dark m-0 fw-bold"><i class="fa-solid fa-industry text-primary"></i> CONFIPETROL S.A.S.</h3>
                <h4 class="text-secondary m-0">DASHBOARD INSPECCIONES VISUALES DE INTEGRIDAD</h4>
            </div>
        </div>
    </div>

    <!-- Tarjetas KPI Superiores -->
    <div class="row">
        <div class="col-md-3 col-sm-6">
            <div class="card-kpi">
                <div class="kpi-title">Total Hallazgos Reportados</div>
                <div class="kpi-value" id="valTotalHallazgos">65</div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="card-kpi alta">
                <div class="kpi-title">Hallazgos Prioridad Alta</div>
                <div class="kpi-value text-danger" id="valAlta">26</div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="card-kpi media">
                <div class="kpi-title">Equipos Inspeccionados</div>
                <div class="kpi-value text-warning" id="valEquipos">8</div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="card-kpi baja">
                <div class="kpi-title">Estaciones Activas</div>
                <div class="kpi-value text-success">6</div>
            </div>
        </div>
    </div>

    <!-- Sección de Gráficos -->
    <div class="row">
        <div class="col-lg-7">
            <div class="chart-container">
                <h5 class="fw-bold mb-3 text-primary"><i class="fa-solid fa-chart-bar"></i> Hallazgos por Estación</h5>
                <canvas id="graficoEstaciones" height="130"></canvas>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="chart-container">
                <h5 class="fw-bold mb-3 text-primary"><i class="fa-solid fa-chart-pie"></i> Distribución por Prioridad</h5>
                <canvas id="graficoPrioridad" height="130"></canvas>
            </div>
        </div>
    </div>

    <!-- Tabla Interactiva Inferior -->
    <div class="row">
        <div class="col-12">
            <div class="table-section">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold text-primary m-0"><i class="fa-solid fa-table"></i> Cuadro Consolidado de Actividades</h5>
                    <input type="text" id="buscadorTabla" class="form-control w-25" placeholder="Buscar por código, equipo o estación...">
                </div>
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle" id="tablaConsolidada">
                        <thead class="table-dark">
                            <tr>
                                <th>Código</th>
                                <th>Capítulo</th>
                                <th>Descripción</th>
                                <th>Unidad</th>
                                <th>Lizama</th>
                                <th>Chimita</th>
                                <th>Sebastopol</th>
                                <th>Vasconia</th>
                                <th>Galán</th>
                                <th>Santa Rosa</th>
                                <th>Total Hallazgos</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>C-L&T-126</td>
                                <td>Recubrimiento</td>
                                <td>Aplicación manual de recubrimiento en estructuras aéreas</td>
                                <td>m²</td>
                                <td>0.60</td>
                                <td>-</td>
                                <td>75.00</td>
                                <td>22.56</td>
                                <td>-</td>
                                <td>-</td>
                                <td><span class="badge bg-danger">25</span></td>
                            </tr>
                            <tr>
                                <td>C-L&T-120</td>
                                <td>Limpieza</td>
                                <td>Preparación de superficie metálica manual mecánica</td>
                                <td>m²</td>
                                <td>-</td>
                                <td>-</td>
                                <td>-</td>
                                <td>25.54</td>
                                <td>-</td>
                                <td>-</td>
                                <td><span class="badge bg-success">3</span></td>
                            </tr>
                            <tr>
                                <td>C-L&T-048</td>
                                <td>Mecánica</td>
                                <td>Cambio de empaque en unión bridada</td>
                                <td>und</td>
                                <td>-</td>
                                <td>-</td>
                                <td>-</td>
                                <td>1.00</td>
                                <td>-</td>
                                <td>-</td>
                                <td><span class="badge bg-danger">1</span></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts de Gráficos -->
    <script>
        // Gráfico de Barras por Estación
        const ctxEstaciones = document.getElementById('graficoEstaciones').getContext('2d');
        new Chart(ctxEstaciones, {
            type: 'bar',
            data: {
                labels: ['Lizama', 'Chimita', 'Sebastopol', 'Vasconia', 'Galán', 'Santa Rosa'],
                datasets: [{
                    label: 'Hallazgos reportados',
                    data: [3, 0, 5, 22, 0, 35],
                    backgroundColor: '#1b365d',
                    borderRadius: 4
                }]
            },
            options: {
                responsive: true,
                plugins: { legend: { display: false } }
            }
        });

        // Gráfico Circular de Prioridades
        const ctxPrioridad = document.getElementById('graficoPrioridad').getContext('2d');
        new Chart(ctxPrioridad, {
            type: 'doughnut',
            data: {
                labels: ['Alta', 'Media', 'Baja'],
                datasets: [{
                    data: [26, 15, 24],
                    backgroundColor: ['#dc3545', '#ffc107', '#198754']
                }]
            },
            options: {
                responsive: true
            }
        });

        // Buscador interactivo en tabla
        document.getElementById('buscadorTabla').addEventListener('keyup', function() {
            let filtro = this.value.toLowerCase();
            let filas = document.querySelectorAll('#tablaConsolidada tbody tr');
            filas.forEach(fila => {
                let texto = fila.textContent.toLowerCase();
                fila.style.display = texto.includes(filtro) ? '' : 'none';
            });
        });
    </script>
</body>
</html>
